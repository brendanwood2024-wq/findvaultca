<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>FindVault | Loop Quiet Earplugs Vlog</title>

  <style>
    :root {
      --bg: #f6f7fb;
      --dark: #10131f;
      --text: #111827;
      --muted: #667085;
      --purple: #6d5dfc;
      --purple2: #8b5cf6;
      --white: #ffffff;
      --border: #e8eaf0;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    /* HEADER */

    header {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 7%;
      background: rgba(255,255,255,0.9);
      backdrop-filter: blur(15px);
      border-bottom: 1px solid var(--border);
    }

    .logo {
      font-size: 27px;
      font-weight: 900;
      letter-spacing: -1px;
    }

    .logo span {
      color: var(--purple);
    }

    nav {
      display: flex;
      gap: 30px;
    }

    nav a {
      font-size: 15px;
      font-weight: 700;
      color: #475467;
    }

    nav a:hover {
      color: var(--purple);
    }

    /* HERO */

    .hero {
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(circle at 20% 20%, rgba(139,92,246,0.35), transparent 30%),
        radial-gradient(circle at 80% 30%, rgba(109,93,252,0.30), transparent 35%),
        #10131f;

      color: white;
      padding: 110px 7%;
    }

    .hero-container {
      max-width: 1150px;
      margin: auto;

      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 60px;
    }

    .badge {
      display: inline-block;
      background: linear-gradient(
        135deg,
        var(--purple),
        var(--purple2)
      );

      padding: 10px 18px;
      border-radius: 50px;

      font-size: 13px;
      font-weight: 800;

      margin-bottom: 25px;
    }

    .hero h1 {
      font-size: clamp(42px, 5vw, 68px);
      line-height: 1.05;
      letter-spacing: -3px;
      margin-bottom: 22px;
    }

    .hero h1 span {
      background: linear-gradient(
        90deg,
        #b9a9ff,
        #8b5cf6
      );

      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .subtitle {
      color: #c8cad3;
      font-size: 18px;
      max-width: 650px;
      margin-bottom: 30px;
    }

    .hero-button {
      display: inline-block;

      padding: 15px 25px;

      background: linear-gradient(
        135deg,
        var(--purple),
        var(--purple2)
      );

      color: white;

      border-radius: 12px;

      font-weight: 800;

      box-shadow:
        0 15px 35px rgba(109,93,252,0.35);

      transition: 0.25s;
    }

    .hero-button:hover {
      transform: translateY(-3px);
    }

    /* PRODUCT IMAGE */

    .product-image {
      display: flex;
      justify-content: center;
      align-items: center;

      padding: 35px;

      background:
        radial-gradient(
          circle,
          rgba(139,92,246,0.35),
          transparent 65%
        );
    }

    .product-image img {
      width: 100%;
      max-width: 500px;

      border-radius: 25px;

      object-fit: contain;

      filter:
        drop-shadow(0 30px 45px rgba(0,0,0,0.5));
    }

    /* VLOG */

    section {
      padding: 80px 7%;
    }

    .section-container {
      max-width: 1150px;
      margin: auto;
    }

    .section-title {
      font-size: 36px;
      margin-bottom: 10px;
      letter-spacing: -1px;
    }

    .section-description {
      color: var(--muted);
      margin-bottom: 30px;
    }

    .vlog-card {
      background: white;

      border: 1px solid var(--border);

      border-radius: 22px;

      overflow: hidden;

      box-shadow:
        0 20px 50px rgba(16,24,40,0.08);

      display: grid;
      grid-template-columns: 45% 55%;
    }

    .vlog-image {
      min-height: 350px;

      background:
        radial-gradient(
          circle at center,
          #8b5cf6,
          #10131f 70%
        );

      display: flex;
      align-items: center;
      justify-content: center;

      padding: 30px;
    }

    .vlog-image img {
      width: 100%;
      height: 100%;
      max-height: 400px;

      object-fit: contain;

      border-radius: 15px;
    }

    .vlog-content {
      padding: 45px;
    }

    .vlog-label {
      color: var(--purple);
      font-size: 13px;
      font-weight: 900;
      letter-spacing: 1px;

      margin-bottom: 12px;
    }

    .vlog-content h2 {
      font-size: 32px;
      line-height: 1.15;

      margin-bottom: 15px;
    }

    .vlog-content p {
      color: var(--muted);
      margin-bottom: 25px;
    }

    .vlog-button {
      display: inline-block;

      background: var(--dark);

      color: white;

      padding: 13px 22px;

      border-radius: 10px;

      font-weight: 800;

      transition: 0.25s;
    }

    .vlog-button:hover {
      background: var(--purple);
      transform: translateY(-2px);
    }

    /* ABOUT */

    .about {
      background: white;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);

      text-align: center;
    }

    .about h2 {
      font-size: 32px;
      margin-bottom: 15px;
    }

    .about p {
      max-width: 700px;
      margin: auto;

      color: var(--muted);
    }

    /* FOOTER */

    footer {
      background: var(--dark);
      color: white;

      text-align: center;

      padding: 45px 20px;
    }

    footer h3 {
      font-size: 22px;
    }

    footer p {
      color: #9ca3af;
      font-size: 13px;
      margin-top: 8px;
    }

    /* MOBILE */

    @media (max-width: 800px) {

      header {
        flex-direction: column;
        gap: 15px;
      }

      nav {
        gap: 18px;
      }

      .hero-container {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .subtitle {
        margin-left: auto;
        margin-right: auto;
      }

      .vlog-card {
        grid-template-columns: 1fr;
      }

      .vlog-image {
        min-height: 280px;
      }
    }

    @media (max-width: 500px) {

      .hero {
        padding: 75px 6%;
      }

      section {
        padding: 60px 6%;
      }

      .hero h1 {
        font-size: 42px;
      }

      .vlog-content {
        padding: 30px;
      }

      .vlog-content h2 {
        font-size: 27px;
      }
    }
  </style>
</head>

<body>

